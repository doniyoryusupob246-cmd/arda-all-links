# Copy to .env.local for local development; set the same values in
# Vercel → Project → Settings → Environment Variables.

# Added automatically when a Neon database is connected in Vercel → Storage
DATABASE_URL=

# Added automatically when a Blob store is connected in Vercel → Storage
BLOB_READ_WRITE_TOKEN=

# Secret admin URL — starts with "/", hard to guess, not "/admin"
ADMIN_PATH=
# Admin login password
ADMIN_PASSWORD=
# Random string for signing the session cookie: openssl rand -base64 32
ADMIN_SECRET=
